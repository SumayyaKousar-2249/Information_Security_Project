
import java.security.*;
import java.security.spec.MGF1ParameterSpec;
import javax.crypto.Cipher;
import javax.crypto.spec.OAEPParameterSpec;
import javax.crypto.spec.PSource;
import java.nio.charset.StandardCharsets;
import java.util.Base64;
import java.util.Scanner;

public class RSASecureCommunication {

    // Generate RSA public and private keys
    public static KeyPair generateKeyPair() throws Exception {

        KeyPairGenerator keyPairGenerator =
                KeyPairGenerator.getInstance("RSA");

        keyPairGenerator.initialize(2048);

        return keyPairGenerator.generateKeyPair();
    }

    // RSA OAEP encryption configuration
    private static OAEPParameterSpec getOAEPParameters() {

        return new OAEPParameterSpec(
                "SHA-256",
                "MGF1",
                MGF1ParameterSpec.SHA256,
                PSource.PSpecified.DEFAULT
        );
    }

    // Encrypt message using receiver's public key
    public static String encrypt(String message,
                                 PublicKey publicKey)
            throws Exception {

        Cipher cipher = Cipher.getInstance(
                "RSA/ECB/OAEPPadding"
        );

        cipher.init(
                Cipher.ENCRYPT_MODE,
                publicKey,
                getOAEPParameters()
        );

        byte[] encryptedBytes = cipher.doFinal(
                message.getBytes(StandardCharsets.UTF_8)
        );

        return Base64.getEncoder()
                .encodeToString(encryptedBytes);
    }

    // Decrypt message using receiver's private key
    public static String decrypt(String encryptedMessage,
                                 PrivateKey privateKey)
            throws Exception {

        Cipher cipher = Cipher.getInstance(
                "RSA/ECB/OAEPPadding"
        );

        cipher.init(
                Cipher.DECRYPT_MODE,
                privateKey,
                getOAEPParameters()
        );

        byte[] encryptedBytes = Base64.getDecoder()
                .decode(encryptedMessage);

        byte[] decryptedBytes = cipher.doFinal(
                encryptedBytes
        );

        return new String(
                decryptedBytes,
                StandardCharsets.UTF_8
        );
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        try {

            // Generate sender's key pair
            KeyPair senderKeys = generateKeyPair();

            // Generate receiver's key pair
            KeyPair receiverKeys = generateKeyPair();

            System.out.println(
                    "RSA-Based Secure Message Communication System"
            );

            System.out.println("-------------------------------------------");

            System.out.print("Enter message to send: ");

            String message = sc.nextLine();

            // Sender encrypts using receiver's public key
            String encryptedMessage = encrypt(
                    message,
                    receiverKeys.getPublic()
            );

            System.out.println("\nEncrypted Message:");
            System.out.println(encryptedMessage);

            // Receiver decrypts using receiver's private key
            String decryptedMessage = decrypt(
                    encryptedMessage,
                    receiverKeys.getPrivate()
            );

            System.out.println("\nDecrypted Message:");
            System.out.println(decryptedMessage);

            System.out.println(
                    "\nMessage successfully received!"
            );

        } catch (Exception e) {

            System.out.println(
                    "Error: " + e.getMessage()
            );

        } finally {

            sc.close();
        }
    }
}
